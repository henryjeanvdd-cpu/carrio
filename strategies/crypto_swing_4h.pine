//@version=5
strategy("Crypto Swing Trading 4H - BTC/ETH",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=95,
     commission_type=strategy.commission.percent,
     commission_value=0.075,
     slippage=2,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_bars_back=500)

// ============================================================================
// STRATEGY OVERVIEW
// ============================================================================
// Multi-indicator confluence swing trading strategy for BTC & ETH on 4H.
//
// ENTRY CONDITIONS (Long) - requires ALL of:
//   1. Price above 200 EMA (trend filter)
//   2. 21 EMA > 50 EMA (medium-term trend alignment)
//   3. RSI between 40-70 (not overbought, with momentum)
//   4. MACD histogram positive and rising
//   5. Stochastic RSI K-line crosses above D-line below 50
//   6. ADX > 20 (trending market, avoid chop)
//   7. Volume above 1.2x 20-period average (participation confirmation)
//   8. Price near support (within 2% of 21 EMA or Bollinger lower band)
//
// ENTRY CONDITIONS (Short) - requires ALL of:
//   1. Price below 200 EMA
//   2. 21 EMA < 50 EMA
//   3. RSI between 30-60 (not oversold, with bearish momentum)
//   4. MACD histogram negative and falling
//   5. Stochastic RSI K-line crosses below D-line above 50
//   6. ADX > 20
//   7. Volume above 1.2x 20-period average
//   8. Price near resistance (within 2% of 21 EMA or Bollinger upper band)
//
// EXIT: Trailing stop + fixed stop loss + take profit targets
// ============================================================================

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// --- Trend Filters ---
grp_trend = "Trend Filters"
ema_fast_len    = input.int(21, "Fast EMA Length", minval=5, maxval=50, group=grp_trend)
ema_mid_len     = input.int(50, "Mid EMA Length", minval=20, maxval=100, group=grp_trend)
ema_slow_len    = input.int(200, "Slow EMA (Trend) Length", minval=100, maxval=300, group=grp_trend)

// --- RSI Settings ---
grp_rsi = "RSI Settings"
rsi_len         = input.int(14, "RSI Length", minval=5, maxval=30, group=grp_rsi)
rsi_long_min    = input.int(40, "RSI Long Min", minval=20, maxval=50, group=grp_rsi)
rsi_long_max    = input.int(70, "RSI Long Max", minval=60, maxval=85, group=grp_rsi)
rsi_short_min   = input.int(30, "RSI Short Min", minval=15, maxval=45, group=grp_rsi)
rsi_short_max   = input.int(60, "RSI Short Max", minval=50, maxval=80, group=grp_rsi)

// --- Stochastic RSI ---
grp_stoch = "Stochastic RSI"
stoch_len       = input.int(14, "Stoch RSI Length", minval=5, maxval=30, group=grp_stoch)
stoch_k_smooth  = input.int(3, "K Smoothing", minval=1, maxval=10, group=grp_stoch)
stoch_d_smooth  = input.int(3, "D Smoothing", minval=1, maxval=10, group=grp_stoch)
stoch_long_thr  = input.int(50, "Long Entry Threshold", minval=20, maxval=60, group=grp_stoch)
stoch_short_thr = input.int(50, "Short Entry Threshold", minval=40, maxval=80, group=grp_stoch)

// --- MACD Settings ---
grp_macd = "MACD Settings"
macd_fast       = input.int(12, "MACD Fast", minval=5, maxval=20, group=grp_macd)
macd_slow       = input.int(26, "MACD Slow", minval=15, maxval=40, group=grp_macd)
macd_signal     = input.int(9, "MACD Signal", minval=3, maxval=15, group=grp_macd)

// --- ADX Settings ---
grp_adx = "ADX / Trend Strength"
adx_len         = input.int(14, "ADX Length", minval=5, maxval=30, group=grp_adx)
adx_threshold   = input.int(20, "ADX Min Threshold", minval=10, maxval=35, group=grp_adx)

// --- Volume Filter ---
grp_vol = "Volume Filter"
vol_ma_len      = input.int(20, "Volume MA Length", minval=5, maxval=50, group=grp_vol)
vol_multiplier  = input.float(1.2, "Volume Multiplier", minval=0.5, maxval=3.0, step=0.1, group=grp_vol)

// --- Bollinger Bands ---
grp_bb = "Bollinger Bands"
bb_len          = input.int(20, "BB Length", minval=10, maxval=50, group=grp_bb)
bb_mult         = input.float(2.0, "BB Multiplier", minval=1.0, maxval=3.0, step=0.1, group=grp_bb)
proximity_pct   = input.float(2.0, "Proximity to Support/Resistance (%)", minval=0.5, maxval=5.0, step=0.5, group=grp_bb)

// --- Risk Management ---
grp_risk = "Risk Management"
sl_pct          = input.float(3.0, "Stop Loss %", minval=0.5, maxval=10.0, step=0.5, group=grp_risk)
tp1_pct         = input.float(4.0, "Take Profit 1 %", minval=1.0, maxval=15.0, step=0.5, group=grp_risk)
tp2_pct         = input.float(7.0, "Take Profit 2 %", minval=2.0, maxval=25.0, step=0.5, group=grp_risk)
use_trailing    = input.bool(true, "Use Trailing Stop", group=grp_risk)
trail_pct       = input.float(2.0, "Trailing Stop %", minval=0.5, maxval=5.0, step=0.5, group=grp_risk)
tp1_exit_pct    = input.float(50, "% to Exit at TP1", minval=10, maxval=90, step=10, group=grp_risk)

// --- Session & Cooldown ---
grp_session = "Trade Management"
cooldown_bars   = input.int(6, "Cooldown Bars After Trade", minval=1, maxval=20, group=grp_session)
max_daily_trades = input.int(2, "Max Trades Per Day", minval=1, maxval=5, group=grp_session)

// --- Higher Timeframe Filter ---
grp_htf = "Higher Timeframe Filter"
use_htf_filter  = input.bool(true, "Use Daily EMA Filter", group=grp_htf)
htf_ema_len     = input.int(50, "Daily EMA Length", minval=10, maxval=200, group=grp_htf)

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

// --- EMAs ---
ema_fast = ta.ema(close, ema_fast_len)
ema_mid  = ta.ema(close, ema_mid_len)
ema_slow = ta.ema(close, ema_slow_len)

// --- RSI ---
rsi_val = ta.rsi(close, rsi_len)

// --- Stochastic RSI ---
stoch_rsi = ta.rsi(close, stoch_len)
stoch_k_raw = ta.stoch(stoch_rsi, stoch_rsi, stoch_rsi, stoch_len)
stoch_k = ta.sma(stoch_k_raw, stoch_k_smooth)
stoch_d = ta.sma(stoch_k, stoch_d_smooth)

// --- MACD ---
[macd_line, signal_line, hist_val] = ta.macd(close, macd_fast, macd_slow, macd_signal)

// --- ADX ---
// Manual ADX calculation
dmi_len = adx_len
up_move = high - high[1]
down_move = low[1] - low
plus_dm = (up_move > down_move and up_move > 0) ? up_move : 0.0
minus_dm = (down_move > up_move and down_move > 0) ? down_move : 0.0
atr_val = ta.atr(dmi_len)
plus_di = 100 * ta.rma(plus_dm, dmi_len) / atr_val
minus_di = 100 * ta.rma(minus_dm, dmi_len) / atr_val
dx = math.abs(plus_di - minus_di) / (plus_di + minus_di) * 100
adx_val = ta.rma(dx, dmi_len)

// --- Volume ---
vol_ma = ta.sma(volume, vol_ma_len)
vol_confirm = volume > vol_ma * vol_multiplier

// --- Bollinger Bands ---
bb_basis = ta.sma(close, bb_len)
bb_dev = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// --- Higher Timeframe Filter ---
htf_ema = request.security(syminfo.tickerid, "D", ta.ema(close, htf_ema_len), lookahead=barmerge.lookahead_off)

// ============================================================================
// SIGNAL CONDITIONS
// ============================================================================

// --- Trend Conditions ---
trend_bullish = close > ema_slow and ema_fast > ema_mid
trend_bearish = close < ema_slow and ema_fast < ema_mid

// --- RSI Conditions ---
rsi_long_ok  = rsi_val >= rsi_long_min and rsi_val <= rsi_long_max
rsi_short_ok = rsi_val >= rsi_short_min and rsi_val <= rsi_short_max

// --- Stochastic RSI Conditions ---
stoch_long_cross  = ta.crossover(stoch_k, stoch_d) and stoch_k[1] < stoch_long_thr
stoch_short_cross = ta.crossunder(stoch_k, stoch_d) and stoch_k[1] > stoch_short_thr

// --- MACD Conditions ---
macd_long_ok  = hist_val > 0 and hist_val > hist_val[1]
macd_short_ok = hist_val < 0 and hist_val < hist_val[1]

// --- ADX Condition ---
adx_trending = adx_val > adx_threshold

// --- Proximity to Support/Resistance ---
prox_factor = proximity_pct / 100
near_support    = close <= ema_fast * (1 + prox_factor) or close <= bb_lower * (1 + prox_factor)
near_resistance = close >= ema_fast * (1 - prox_factor) or close >= bb_upper * (1 - prox_factor)

// --- HTF Filter ---
htf_long_ok  = use_htf_filter ? close > htf_ema : true
htf_short_ok = use_htf_filter ? close < htf_ema : true

// --- Cooldown Logic ---
var int bars_since_exit = 100
if strategy.closedtrades > 0
    if strategy.closedtrades != strategy.closedtrades[1]
        bars_since_exit := 0
bars_since_exit := bars_since_exit + 1
cooldown_ok = bars_since_exit > cooldown_bars

// ============================================================================
// ENTRY SIGNALS (Full Confluence)
// ============================================================================

long_signal = trend_bullish
     and rsi_long_ok
     and stoch_long_cross
     and macd_long_ok
     and adx_trending
     and vol_confirm
     and near_support
     and htf_long_ok
     and cooldown_ok

short_signal = trend_bearish
     and rsi_short_ok
     and stoch_short_cross
     and macd_short_ok
     and adx_trending
     and vol_confirm
     and near_resistance
     and htf_short_ok
     and cooldown_ok

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================

// --- Entry ---
if long_signal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if short_signal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

// --- Exit Management ---
// Calculate stop and target levels based on entry price
if strategy.position_size > 0  // Long position
    entry_price = strategy.position_avg_price
    stop_price = entry_price * (1 - sl_pct / 100)
    tp1_price = entry_price * (1 + tp1_pct / 100)
    tp2_price = entry_price * (1 + tp2_pct / 100)

    // Stop Loss
    strategy.exit("Long SL", "Long", stop=stop_price)

    // Take Profit 1 - partial exit
    strategy.exit("Long TP1", "Long", limit=tp1_price, qty_percent=tp1_exit_pct)

    // Take Profit 2 - remaining position
    if use_trailing
        strategy.exit("Long TP2/Trail", "Long", limit=tp2_price, trail_price=tp1_price, trail_offset=math.round(entry_price * trail_pct / 100 / syminfo.mintick))
    else
        strategy.exit("Long TP2", "Long", limit=tp2_price)

if strategy.position_size < 0  // Short position
    entry_price = strategy.position_avg_price
    stop_price = entry_price * (1 + sl_pct / 100)
    tp1_price = entry_price * (1 - tp1_pct / 100)
    tp2_price = entry_price * (1 - tp2_pct / 100)

    // Stop Loss
    strategy.exit("Short SL", "Short", stop=stop_price)

    // Take Profit 1 - partial exit
    strategy.exit("Short TP1", "Short", limit=tp1_price, qty_percent=tp1_exit_pct)

    // Take Profit 2 - remaining position
    if use_trailing
        strategy.exit("Short TP2/Trail", "Short", limit=tp2_price, trail_price=tp1_price, trail_offset=math.round(entry_price * trail_pct / 100 / syminfo.mintick))
    else
        strategy.exit("Short TP2", "Short", limit=tp2_price)

// --- Emergency RSI Exit ---
if strategy.position_size > 0 and rsi_val > 80
    strategy.close("Long", comment="RSI Overbought Exit")

if strategy.position_size < 0 and rsi_val < 20
    strategy.close("Short", comment="RSI Oversold Exit")

// --- EMA Cross Against Position Exit ---
if strategy.position_size > 0 and ta.crossunder(ema_fast, ema_mid)
    strategy.close("Long", comment="EMA Bearish Cross Exit")

if strategy.position_size < 0 and ta.crossover(ema_fast, ema_mid)
    strategy.close("Short", comment="EMA Bullish Cross Exit")

// ============================================================================
// VISUAL ELEMENTS
// ============================================================================

// --- Plot EMAs ---
plot(ema_fast, "Fast EMA", color=color.new(color.blue, 0), linewidth=1)
plot(ema_mid, "Mid EMA", color=color.new(color.orange, 0), linewidth=1)
plot(ema_slow, "Slow EMA (Trend)", color=color.new(color.red, 0), linewidth=2)

// --- Plot BB ---
p_bb_upper = plot(bb_upper, "BB Upper", color=color.new(color.gray, 70))
p_bb_lower = plot(bb_lower, "BB Lower", color=color.new(color.gray, 70))
fill(p_bb_upper, p_bb_lower, color=color.new(color.gray, 90))

// --- HTF EMA ---
plot(use_htf_filter ? htf_ema : na, "Daily EMA", color=color.new(color.purple, 0), linewidth=2, style=plot.style_stepline)

// --- Signal Markers ---
plotshape(long_signal and strategy.position_size == 0, "Long Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.normal)
plotshape(short_signal and strategy.position_size == 0, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.normal)

// --- Background Color for Trend ---
bgcolor(trend_bullish ? color.new(color.green, 95) : trend_bearish ? color.new(color.red, 95) : na)

// ============================================================================
// DASHBOARD TABLE
// ============================================================================

var table dash = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "INDICATOR", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))
    table.cell(dash, 1, 0, "STATUS", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 60))

    // Trend
    table.cell(dash, 0, 1, "Trend (200 EMA)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, trend_bullish ? "BULLISH ✓" : trend_bearish ? "BEARISH ✓" : "NEUTRAL ✗",
         text_color=trend_bullish ? color.green : trend_bearish ? color.red : color.gray, text_size=size.tiny)

    // EMA Alignment
    table.cell(dash, 0, 2, "EMA Alignment", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, ema_fast > ema_mid ? "BULLISH ✓" : "BEARISH ✓",
         text_color=ema_fast > ema_mid ? color.green : color.red, text_size=size.tiny)

    // RSI
    table.cell(dash, 0, 3, "RSI (" + str.tostring(rsi_val, "#.0") + ")", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, rsi_long_ok ? "LONG OK ✓" : rsi_short_ok ? "SHORT OK ✓" : "NEUTRAL ✗",
         text_color=rsi_long_ok ? color.green : rsi_short_ok ? color.red : color.gray, text_size=size.tiny)

    // Stoch RSI
    table.cell(dash, 0, 4, "Stoch RSI", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, stoch_k > stoch_d ? "BULLISH ✓" : "BEARISH ✓",
         text_color=stoch_k > stoch_d ? color.green : color.red, text_size=size.tiny)

    // MACD
    table.cell(dash, 0, 5, "MACD Histogram", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, macd_long_ok ? "BULLISH ✓" : macd_short_ok ? "BEARISH ✓" : "NEUTRAL ✗",
         text_color=macd_long_ok ? color.green : macd_short_ok ? color.red : color.gray, text_size=size.tiny)

    // ADX
    table.cell(dash, 0, 6, "ADX (" + str.tostring(adx_val, "#.0") + ")", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, adx_trending ? "TRENDING ✓" : "CHOPPY ✗",
         text_color=adx_trending ? color.green : color.gray, text_size=size.tiny)

    // Volume
    table.cell(dash, 0, 7, "Volume", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 7, vol_confirm ? "CONFIRMED ✓" : "LOW ✗",
         text_color=vol_confirm ? color.green : color.gray, text_size=size.tiny)

    // HTF
    table.cell(dash, 0, 8, "Daily Trend", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 8, close > htf_ema ? "BULLISH ✓" : "BEARISH ✓",
         text_color=close > htf_ema ? color.green : color.red, text_size=size.tiny)

    // Position
    table.cell(dash, 0, 9, "Position", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 9, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT",
         text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, text_size=size.tiny)

    // Win Rate
    total_trades = strategy.closedtrades
    wins = strategy.wintrades
    win_rate = total_trades > 0 ? (wins / total_trades) * 100 : 0.0
    table.cell(dash, 0, 10, "Win Rate", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(win_rate, "#.1") + "% (" + str.tostring(wins) + "/" + str.tostring(total_trades) + ")",
         text_color=win_rate >= 80 ? color.green : win_rate >= 60 ? color.yellow : color.red, text_size=size.tiny)

    // Profit Factor
    table.cell(dash, 0, 11, "Profit Factor", text_color=color.white, text_size=size.tiny)
    pf = strategy.grossprofit / math.max(strategy.grossloss, 1)
    table.cell(dash, 1, 11, str.tostring(pf, "#.2"),
         text_color=pf >= 2 ? color.green : pf >= 1 ? color.yellow : color.red, text_size=size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(long_signal and strategy.position_size == 0, "Long Entry Signal", "CRYPTO SWING: Long entry signal on {{ticker}} 4H")
alertcondition(short_signal and strategy.position_size == 0, "Short Entry Signal", "CRYPTO SWING: Short entry signal on {{ticker}} 4H")
